# Server Configuration
PORT=3001
NODE_ENV=production

# MongoDB Connection (use MongoDB Atlas free tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/geo-audit

# OpenAI API Key (optional - for enhanced LLM analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Puppeteer configuration
PUPPETEER_TIMEOUT=90000
PUPPETEER_RETRIES=3

# CORS - Allow your frontend domain
ALLOWED_ORIGINS=https://your-netlify-domain.netlify.app,https://yourdomain.com

# Optional: For email notifications
SENDGRID_API_KEY=your_sendgrid_api_key

# Optional: For CRM integration
HUBSPOT_API_KEY=your_hubspot_api_key
